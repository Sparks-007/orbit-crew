# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# runtime database (sandbox sqlite)
/db

# delivered patch archives (transfer artifacts, never committed)
public/*.zip
public/*.manifest.txt

# sandbox runtime tooling and state
/.zscripts

# sandbox artifacts removed before public release — do not reintroduce
/tool-results/
/mini-services/
/download/
/examples/websocket/
/Caddyfile

# vercel
.vercel


# typescript
*.tsbuildinfo
next-env.d.ts
local-*
.claude
.z-ai-config
*.log
dev.log
dev.out.log

server.log
# Skills directory
/skills/