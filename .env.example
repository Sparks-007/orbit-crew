# Orbit Crew — environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env itself.

# ---------------------------------------------------------------------------
# Database
# SQLite for local development; PostgreSQL is the production target.
# The file: URL is resolved relative to prisma/schema.prisma, so this points
# to <project root>/db/custom.db. The db/ directory is gitignored.
# See docs/architecture/database.md for the provider switch and schema notes.
# ---------------------------------------------------------------------------
DATABASE_URL=file:../db/custom.db

# ---------------------------------------------------------------------------
# Security
# AUTH_SECRET: HMAC key for session tokens at rest. A leaked database dump
# without this secret cannot be replayed as sessions.
# Generate with:  openssl rand -base64 32
# NOTE: production startup REJECTS a secret that still starts with
# "change-me" — the placeholder below only works in development.
# ---------------------------------------------------------------------------
AUTH_SECRET=change-me-generate-a-unique-secret-with-openssl-rand-base64-32

# ---------------------------------------------------------------------------
# Application
# Canonical public URL of the deployment. Used as an additional allowed
# origin in CSRF checks behind proxies/gateways. Optional in development.
# ---------------------------------------------------------------------------
APP_URL=http://localhost:3000
